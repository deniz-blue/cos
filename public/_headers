/fonts/*.ttf
  Content-Type: font/ttf
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/**/*.ttf
  Content-Type: font/ttf
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/**/*.woff
  Content-Type: font/woff
  Cache-Control: public, max-age=31536000, immutable

/assets/**/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
