{
	"expo": {
		"name": "cos",
		"slug": "cos-share",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./public/maskable-icon.png",
		"scheme": "cos",
		"userInterfaceStyle": "dark",
		"android": {
			"predictiveBackGestureEnabled": false,
			"package": "lt.tsx.cos",
			"intentFilters": [
				{
					"autoVerify": true,
					"action": "VIEW",
					"data": [
						{
							"scheme": "https",
							"host": "cos.tsx.lt",
							"pathPrefix": "/"
						}
					],
					"category": [
						"BROWSABLE",
						"DEFAULT"
					]
				}
			]
		},
		"web": {
			"output": "single",
			"favicon": "./public/cos.svg"
		},
		"plugins": [
			[
				"expo-router",
				{
					"sitemap": false
				}
			],
			[
				"expo-font",
				{
					"fonts": [
						"./node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf"
					]
				}
			],
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#000000",
					"android": {
						"image": "./public/splash.png",
						"resizeMode": "contain",
						"backgroundColor": "#000000",
						"imageWidth": 578
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {}
		},
		"owner": "deniz.blue"
	}
}