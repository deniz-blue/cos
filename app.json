{
	"expo": {
		"name": "cos",
		"slug": "cos-share",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/splash-icon.png",
		"scheme": "cos",
		"userInterfaceStyle": "dark",
		"android": {
			"predictiveBackGestureEnabled": false,
			"package": "lt.tsx.cos",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#000000"
			}
		},
		"web": {
			"output": "single",
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			[
				"expo-router",
				{
					"sitemap": false
				}
			],
			[
				"expo-font",
				{
					"fonts": [
						"./node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf"
					]
				}
			],
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#000000",
					"android": {
						"image": "./assets/splash.png",
						"resizeMode": "contain",
						"backgroundColor": "#000000",
						"imageWidth": 578
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "1f4879ac-e52b-4101-a7ab-142f8e032295"
			}
		},
		"owner": "deniz.blue"
	}
}